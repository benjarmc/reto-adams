# Contraseña para poder editar datos. Si la dejas vacía, cualquiera con el enlace puede editar.
ADMIN_PASSWORD=cambia-esta-contraseña

# Opcional. Firma la sesión; si no se define se usa ADMIN_PASSWORD.
# SESSION_SECRET=

# Ruta del archivo SQLite. En Docker ya viene como /data/reto.db (volumen).
# En local, por defecto es ./data/reto.db
# DATABASE_PATH=./data/reto.db

# true = en la primera ejecución con la base vacía, carga 5 personas de ejemplo.
SEED_DEMO=true

# Puerto en tu máquina (npm run dev / npm start y mapeo de docker compose).
# Dentro del contenedor la app siempre escucha en 3000.
PORT=3000
